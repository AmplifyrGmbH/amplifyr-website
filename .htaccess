# ── Security-Header ───────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ── Komprimierung ─────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/plain image/svg+xml font/woff2 font/woff
</IfModule>

# ── Browser-Caching ───────────────────────────────────────────
# HTML bewusst NICHT langfristig cachen: anders als CSS/JS/Bilder hat es
# kein Cache-Busting (?v=N) und ändert sich bei jedem Deploy. Mit "access
# plus 1 hour" konnten Geräte bis zu einer Stunde lang eine veraltete
# Seite anzeigen, ohne dass ein normaler Reload das bemerkt hätte (HTTP-
# Caching wird von einem normalen Reload respektiert, nicht umgangen) —
# das hat vermutlich einen grossen Teil der "der Fix kommt nicht an"-
# Meldungen dieser gesamten Session erklärt.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType video/webm                "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# ── Sensible Dateien blockieren ───────────────────────────
<FilesMatch "(\.DS_Store|\.git|\.env|\.aws|\.docker|sftp\.json)">
  Require all denied
</FilesMatch>

# ── Weiterleitungen gelöschter Seiten ─────────────────────
Redirect 301 /branchen-software https://www.amplifyr.ch/it-solutions
Redirect 301 /branchen-software.html https://www.amplifyr.ch/it-solutions

# ── Rewrites ──────────────────────────────────────────────────
RewriteEngine On

# 1. non-www (http + https) → https://www
RewriteCond %{HTTP_HOST} ^amplifyr\.ch [NC]
RewriteRule ^(.*)$ https://www.amplifyr.ch/$1 [R=301,L]

# 2. http://www → https://www
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^www\.amplifyr\.ch [NC]
RewriteRule ^(.*)$ https://www.amplifyr.ch/$1 [R=301,L]

# 3. Clean URLs: .html → ohne Endung (301 Redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]+\ /([^.]+)\.html [NC]
RewriteRule ^ /%1 [R=301,L]

# 4. Clean URLs: saubere URL intern auf .html-Datei mappen
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)/?$ $1.html [L]

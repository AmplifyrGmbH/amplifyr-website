# ── Security-Header ───────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ── Komprimierung ─────────────────────────────────────────────
<IfModule mod_deflate.c>
  # text/javascript muss mit aufgeführt sein — Apache liefert .js-Dateien
  # unter diesem Typ aus, application/javascript allein greift nicht.
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/plain text/xml image/svg+xml font/woff2 font/woff application/manifest+json
</IfModule>

# ── Browser-Caching ───────────────────────────────────────────
# HTML bewusst NICHT langfristig cachen: anders als CSS/JS/Bilder hat es
# kein Cache-Busting (?v=N) und ändert sich bei jedem Deploy. Mit "access
# plus 1 hour" konnten Geräte bis zu einer Stunde lang eine veraltete
# Seite anzeigen, ohne dass ein normaler Reload das bemerkt hätte (HTTP-
# Caching wird von einem normalen Reload respektiert, nicht umgangen) —
# das hat vermutlich einen grossen Teil der "der Fix kommt nicht an"-
# Meldungen dieser gesamten Session erklärt.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType video/webm                "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# ── vCard MIME-Type ───────────────────────────────────────
AddType text/vcard .vcf

# ── Sensible Dateien blockieren ───────────────────────────
<FilesMatch "(\.DS_Store|\.git|\.env|\.aws|\.docker|sftp\.json)">
  Require all denied
</FilesMatch>

# Arbeitsdateien, die nicht ins Web gehören. Der Deploy lädt sie zwar nicht
# mehr hoch (siehe exclude in .github/workflows/deploy.yml), ältere Deploys
# haben aber Reste auf dem Server hinterlassen.
<FilesMatch "\.(md|py|sh|yml|yaml|bak|log|sql|ini)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(scripts|archiv|\.github)(/|$)
<Files "dev-router.php">
  Require all denied
</Files>

# ── Fehlerseite ───────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Rewrites ──────────────────────────────────────────────────
RewriteEngine On

# 0. Permanente Weiterleitungen (301)
# KI, Automatisierung und Branchensoftware sind in /kmu aufgegangen
RewriteRule ^automatisierung(\.html)?/?$ https://www.amplifyr.ch/kmu [R=301,NE,L]
RewriteRule ^ki-transformation(\.html)?/?$ https://www.amplifyr.ch/kmu [R=301,NE,L]
RewriteRule ^branchen-software(\.html)?/?$ https://www.amplifyr.ch/kmu [R=301,NE,L]

# Frühere Seitennamen, die es im Lauf der Zeit gab
RewriteRule ^ki-prozesse(\.html)?/?$ https://www.amplifyr.ch/kmu [R=301,NE,L]
RewriteRule ^business-amplification(\.html)?/?$ / [R=301,L]
RewriteRule ^digitalisierung-handwerker(\.html)?/?$ https://www.amplifyr.ch/handwerker [R=301,NE,L]
RewriteRule ^digitalisierung-kmu(\.html)?/?$ https://www.amplifyr.ch/kmu [R=301,NE,L]
# /blog-post war die Vorlage für einzelne Artikel (?slug=…); die Artikel liegen heute unter /blog/<slug>
RewriteRule ^blog-post(\.html)?/?$ https://www.amplifyr.ch/blog [R=301,NE,L]

# Relaunch 2026: IT und Webdesign sind in /kmu aufgegangen, Kontakt hat eine eigene Seite
RewriteRule ^it-solutions(\.html)?/?$ https://www.amplifyr.ch/kmu [R=301,NE,L]
RewriteRule ^webdesign(\.html)?/?$ https://www.amplifyr.ch/kmu [R=301,NE,L]
# Die frühere Demo-Seite (Website-Demo): Anfragen laufen über das Kontaktformular,
# das Thema KMU deckt Website und Auftritt ab.
RewriteRule ^demo(\.html)?/?$ https://www.amplifyr.ch/kontakt?subject=KMU [R=301,NE,L]
# Query-String (z. B. ?subject=…&domain=…) bleibt erhalten und belegt das Formular vor
RewriteRule ^formular(\.html)?/?$ https://www.amplifyr.ch/kontakt?%{QUERY_STRING} [R=301,NE,L]

# 1. non-www (http + https) → https://www
RewriteCond %{HTTP_HOST} ^amplifyr\.ch [NC]
RewriteRule ^(.*)$ https://www.amplifyr.ch/$1 [R=301,L]

# 2. http://www → https://www
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^www\.amplifyr\.ch [NC]
RewriteRule ^(.*)$ https://www.amplifyr.ch/$1 [R=301,L]

# 3. Clean URLs: .html → ohne Endung (301 Redirect)
# Ausnahme: /blog/preview.html ist ein HTML-Fragment, das die Startseite per
# fetch() lädt — eine Weiterleitung würde die Blog-Vorschau unbrauchbar machen.
RewriteCond %{THE_REQUEST} ^[A-Z]+\ /([^.]+)\.html [NC]
RewriteCond %{REQUEST_URI} !^/blog/preview\.html$
RewriteRule ^ /%1 [R=301,L]

# 4. Clean URLs: saubere URL intern auf .html-Datei mappen
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)/?$ $1.html [L]
